generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ── CONTACT SUBMISSIONS ──────────────────────────────────────────
model ContactSubmission {
    id           String   @id @default(cuid())
    name         String
    organisation String?
    email        String
    phone        String?
    service      String?
    message      String
    read         Boolean  @default(false)
    createdAt    DateTime @default(now())

    @@index([createdAt])
}

// ── COSMOS WRITE ─────────────────────────────────────────────────
model WriteGeneration {
    id           String   @id @default(cuid())
    documentType String
    inputs       Json
    output       String
    sessionId    String
    createdAt    DateTime @default(now())

    @@index([createdAt])
    @@index([documentType])
    @@index([sessionId])
}

// ── SERVICES ─────────────────────────────────────────────────────
model Service {
    id          String   @id @default(cuid())
    number      String
    title       String
    tagline     String
    description String
    deliverables String[]
    pricing     String
    ideal       String
    order       Int      @default(0)
    published   Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([order])
}

// ── ABOUT CONTENT ────────────────────────────────────────────────
model AboutContent {
    id          String   @id @default(cuid())
    key         String   @unique
    value       String
    updatedAt   DateTime @updatedAt
}

// ── VALUES ───────────────────────────────────────────────────────
model Value {
    id          String   @id @default(cuid())
    title       String
    description String
    order       Int      @default(0)
    updatedAt   DateTime @updatedAt

    @@index([order])
}

// ── NEXT AUTH ────────────────────────────────────────────────────
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}